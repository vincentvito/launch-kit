# Database (Supabase Postgres)
# DATABASE_URL — pooled connection used by the app at runtime (transaction pooler, port 6543).
# Must include pgbouncer=true so Prisma disables prepared statements.
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL — direct/session connection used for migrations (port 5432, no pgbouncer).
# prisma migrate uses this so the advisory lock works.
DIRECT_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# App URL (client-side auth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Waiting list gate (homepage only)
# Set to true before launch to show the waitlist page at /. Unset or false shows the full landing page.
WAITING_LIST_ENABLED=""

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Launch Kit AI generation
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional Replicate provider (takes precedence when set)
REPLICATE_API_TOKEN=""
REPLICATE_MODEL="openai/gpt-5-structured"
REPLICATE_OPENAI_MODEL="gpt-5"
REPLICATE_IMAGE_MODEL="google/imagen-4-fast"
REPLICATE_VIDEO_MODEL="google/veo-3.1-fast"

# Optional discovery provider for prospecting/backlink search
# Defaults to local seeded discovery when unset or when the key is missing.
LAUNCH_KIT_DISCOVERY_PROVIDER="mock"
LAUNCH_KIT_SEO_DISCOVERY_PROVIDER="mock"
SERPAPI_API_KEY=""
