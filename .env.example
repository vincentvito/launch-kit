# Database (SQLite default)
DATABASE_URL="file:./dev.db"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# App URL (client-side auth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Launch Kit AI generation
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional Replicate provider (takes precedence when set)
REPLICATE_API_TOKEN=""
REPLICATE_MODEL="openai/gpt-5-structured"
REPLICATE_OPENAI_MODEL="gpt-5"
